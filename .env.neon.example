# Generate ignored .env.neon with: node scripts/configure-docker.mjs --neon
# Fill the runtime mims_app connection from Neon, with TLS enabled.
# A pooled connection is supported. Never use mims_owner or neondb_owner here.
NEON_DATABASE_URL=
SESSION_SECRET=
CSRF_SECRET=
INTEREST_WORKER_TOKEN=
MIMS_NEON_HTTP_PORT=3001
APP_BASE_URL=http://localhost:3001
PGPOOL_MAX=10
