{
  "name": "mims",
  "version": "0.1.0",
  "private": true,
  "description": "Microbanking and Interest Management System (MIMS) — B-Trust Microfinance Bank. CS3043 Group 32.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:create": "bash scripts/db-create.sh",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:status": "node scripts/migrate.mjs status",
    "db:seed": "node scripts/migrate.mjs seed",
    "db:rebuild": "node --env-file=.env scripts/db-rebuild.mjs",
    "db:verify": "node scripts/verify-setup.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:api": "node --test tests/api/*.test.mjs"
  },
  "dependencies": {
    "argon2": "^0.41.0",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
