{
  "name": "mims",
  "version": "0.1.0",
  "private": true,
  "description": "Microbanking and Interest Management System (MIMS) \u2014 B-Trust Microfinance Bank. CS3043 Group 32.",
  "engines": {
    "node": ">=20.0.0"
  },
  "imports": {
    "@/*": [
      "./*"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:customer-schema": "node scripts/verify-customer-schema.mjs",
    "verify:customer-agent-document": "node scripts/verify-customer-schema.mjs --relations",
    "verify:customer-registration": "node scripts/verify-customer-schema.mjs --relations --registration",
    "verify:seed-validation": "node scripts/verify-seed-validation.mjs",
    "db:seed-validate": "node scripts/seed-validation.mjs",
    "db:create": "bash scripts/db-create.sh",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:grants": "node --env-file=.env scripts/apply-grants.mjs",
    "db:status": "node scripts/migrate.mjs status",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "db:rebuild": "node --env-file=.env scripts/db-rebuild.mjs",
    "db:verify": "node scripts/verify-setup.mjs",
    "verify:phase1": "node scripts/verify-phase-01.mjs",
    "test": "node scripts/verify-phase-01.mjs --tests-only",
    "test:db": "node scripts/verify-phase-01.mjs --tests-only --suite=db",
    "test:api": "node scripts/verify-phase-01.mjs --tests-only --suite=api",
    "db:seed-check": "node --env-file=.env scripts/seed-check.mjs"
  },
  "dependencies": {
    "argon2": "^0.41.0",
    "gsap": "^3.15.0",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
