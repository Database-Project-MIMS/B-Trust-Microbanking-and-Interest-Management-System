# Generate the ignored .env.docker with: node scripts/configure-docker.mjs
# Or copy this file and fill every required value. Passwords must be hexadecimal
# so the same values can safely be used in PostgreSQL connection URLs.
MIMS_POSTGRES_PASSWORD=
MIMS_OWNER_PASSWORD=
MIMS_APP_PASSWORD=
SESSION_SECRET=
CSRF_SECRET=
INTEREST_WORKER_TOKEN=
MIMS_HTTP_PORT=3000
APP_BASE_URL=http://localhost:3000
PGPOOL_MAX=10
