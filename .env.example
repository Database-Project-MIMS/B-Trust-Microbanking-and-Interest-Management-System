# ---------------------------------------------------------------------------
# MIMS environment configuration — COPY TO .env AND FILL IN LOCALLY
# .env is gitignored. NEVER commit real values. NEVER use real customer data.
# ---------------------------------------------------------------------------

# Fill both URLs locally. Use mims_app for runtime and mims_owner for migrations.
# For Neon migrations use a direct TLS connection; store it in GitHub environment secrets.
# --- Database -------------------------------------------------------------
# Application role: least privilege. Cannot DROP, cannot UPDATE/DELETE posted ledger rows.
DATABASE_URL=

# Migration/owner role: schema tooling only. In deployment, provide this to the migration
# job, never to the running Next.js application process.
DATABASE_MIGRATION_URL=

# Connection pool sizing (NFR-SEC-08: bounded pool, no connection exhaustion)
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PGSTATEMENT_TIMEOUT_MS=10000

# --- Sessions and security ------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=20
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
CSRF_SECRET=
PASSWORD_HASH_ALGORITHM=argon2id

# --- Interest processing worker ------------------------------------------
# Shared secret the scheduled worker presents when invoking POST /api/interest-runs
INTEREST_WORKER_TOKEN=

# --- Customer e-mail notifications (Gmail SMTP with an App Password) -----
# Set the credentials ONLY in the Vercel project settings (Production) or your local .env.
# Create an App Password at https://myaccount.google.com/apppasswords (2-Step Verification required).
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=
# Bearer secret for GET/POST /api/notifications/dispatch. On Vercel, CRON_SECRET is also accepted.
NOTIFICATION_WORKER_TOKEN=
CRON_SECRET=

# --- Business parameters (defaults; authoritative values live in system_parameter) --
BUSINESS_HOURS_START=08:30
BUSINESS_HOURS_END=16:30
BANK_TIMEZONE=Asia/Colombo

# --- Application ----------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Production must use an HTTPS APP_BASE_URL and terminate TLS at a trusted proxy.
# Never deploy this example file unchanged.

# NOTE: no NEXT_PUBLIC_* variable may ever contain a credential, connection string
# or secret. Anything prefixed NEXT_PUBLIC_ is shipped to the browser.
